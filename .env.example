# Copy this file to .env and enter values locally. Never commit .env.
GNANI_API_KEY=YOUR_GNANI_AQUAVOICE_PROTOTYPE_KEY

# Existing AquaGuard / Google ADK setting. Prefer this name for compatibility.
GOOGLE_API_KEY=YOUR_EXISTING_GEMINI_KEY

# Optional compatibility alias. Leave blank when GOOGLE_API_KEY is set.
GEMINI_API_KEY=
